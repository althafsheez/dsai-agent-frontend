%% DSAI — proposed PostgreSQL schema (logical ER). IDs are UUIDv7 unless noted.
%% Every tenant-owned row carries workspace_id (nullable only for standalone chats and their resources,
%% which are owned by owner_user_id) so authorization and RLS policies can filter on one column.
erDiagram
    users ||--o{ workspace_members : "has"
    workspaces ||--o{ workspace_members : "grants"
    workspaces ||--o{ chats : "contains (nullable)"
    users ||--o{ chats : "creates"
    chats ||--o{ messages : "ordered by position"
    chats ||--o{ agent_runs : "executes"
    messages ||--o{ agent_runs : "user_message (retry => many runs)"
    agent_runs ||--o{ run_steps : "model/tool steps"
    agent_runs ||--o{ execution_events : "ordered by sequence"
    agent_runs ||--o{ steering_instructions : "receives"
    agent_runs |o--o{ agent_runs : "previous_run (retry chain)"
    file_objects ||--o{ resources : "backs (bytes stored once)"
    resources ||--o{ resource_links : "scoped to chat or workspace"
    agent_runs |o--o{ resources : "generated by"
    messages ||--o{ message_attachments : "attaches"
    resources ||--o{ message_attachments : "attached as"
    users ||--o{ favorites : "saves"
    resources ||--o{ favorites : "saved"
    resources ||--o| dataset_profiles : "datasets only"
    users ||--o{ data_connections : "owns"
    data_connections ||--o{ message_connections : "selected for"
    messages ||--o{ message_connections : "selects"
    workspaces ||--o{ dashboards : "contains"
    dashboards ||--o{ dashboard_shares : "shared with"
    workspaces ||--o{ workflows : "contains"
    workflows ||--o{ workflow_runs : "executes"
    users ||--o{ quick_threads : "owns"
    quick_threads ||--o{ quick_messages : "contains"
    agent_runs ||--o{ usage_records : "meters"
    users ||--o{ audit_log : "acts"

    users {
        uuid id PK
        text idp_subject UK "OIDC sub"
        citext email UK
        text name
        timestamptz created_at
        timestamptz disabled_at
    }
    workspaces {
        uuid id PK
        text name
        text description
        uuid created_by FK
        timestamptz archived_at
        timestamptz deleted_at
        timestamptz updated_at
    }
    workspace_members {
        uuid workspace_id PK,FK
        uuid user_id PK,FK
        text role "owner|manager|contributor|viewer"
        timestamptz created_at
    }
    chats {
        uuid id PK
        uuid workspace_id FK "nullable"
        uuid created_by FK
        text title
        text title_source "fallback|generated|manual"
        text client_request_id
        timestamptz first_run_at
        timestamptz archived_at
        timestamptz deleted_at
        timestamptz updated_at
    }
    messages {
        uuid id PK
        uuid chat_id FK
        int position "unique(chat_id, position)"
        text role "user|assistant"
        text kind "normal|steering"
        text status
        text content
        text client_request_id "unique(chat_id, client_request_id)"
        timestamptz created_at
    }
    agent_runs {
        uuid id PK
        uuid chat_id FK
        uuid user_message_id FK
        uuid assistant_message_id FK
        uuid previous_run_id FK
        text status "queued|running|completed|failed|cancelled|interrupted"
        text model_id
        text effort
        text client_request_id "unique(chat_id, client_request_id)"
        text worker_id
        timestamptz lease_until
        timestamptz deadline_at
        timestamptz started_at
        timestamptz finished_at
        text error_code
        jsonb error_detail
    }
    run_steps {
        uuid id PK
        uuid run_id FK
        int step_index
        text kind "model|tool"
        text tool_name
        text status
        jsonb public_arguments "redacted, capped"
        jsonb public_result "redacted, capped; large => file ref"
        int duration_ms
    }
    execution_events {
        uuid run_id PK,FK
        int sequence PK
        uuid event_id UK
        text type
        jsonb data
        timestamptz created_at "partition key (monthly)"
    }
    steering_instructions {
        uuid id PK
        uuid run_id FK
        uuid message_id FK,UK
        text status "received|applied|unapplied"
        text checkpoint
    }
    file_objects {
        uuid id PK
        text sha256
        bigint size_bytes
        text mime_type
        text storage_key "generated; never user-supplied"
        text state "pending|quarantined|ready|rejected"
        timestamptz created_at
    }
    resources {
        uuid id PK
        text resource_type "dataset|artifact"
        text kind "csv|parquet|xlsx|image|chart|pdf|report|..."
        text name
        text origin "uploaded|generated|imported"
        uuid file_object_id FK
        uuid owner_user_id FK
        uuid workspace_id FK "nullable"
        uuid run_id FK "nullable"
        text output_path "generated outputs"
        int version
        text client_upload_id "unique(owner_user_id, client_upload_id)"
        timestamptz deleted_at
    }
    resource_links {
        uuid id PK
        uuid resource_id FK
        text scope_type "chat|workspace"
        uuid scope_id
        uuid created_by FK
    }
    message_attachments {
        uuid message_id PK,FK
        uuid resource_id PK,FK
    }
    dataset_profiles {
        uuid resource_id PK,FK
        bigint row_count
        int column_count
        jsonb columns "name, type, null %, stats"
        text parquet_key
        text preview_key "first 100 rows, JSON"
        text status "pending|ready|failed"
    }
    favorites {
        uuid user_id PK,FK
        uuid resource_id PK,FK
        timestamptz created_at
    }
    data_connections {
        uuid id PK
        uuid owner_user_id FK
        uuid workspace_id FK "nullable"
        text provider "postgresql|google_drive|..."
        bytea credentials_ciphertext "envelope-encrypted (KMS)"
        text key_version
        jsonb settings
    }
    message_connections {
        uuid message_id PK,FK
        uuid connection_id PK,FK
    }
    dashboards {
        uuid id PK
        uuid workspace_id FK
        uuid owner_user_id FK
        jsonb definition "widgets, measures, slicers"
        timestamptz updated_at
    }
    dashboard_shares {
        uuid dashboard_id PK,FK
        uuid user_id PK,FK
        text role
    }
    workflows {
        uuid id PK
        uuid workspace_id FK
        uuid owner_user_id FK
        jsonb definition
        text state "draft|active|paused"
        text timezone
        timestamptz next_run_at
    }
    workflow_runs {
        uuid id PK
        uuid workflow_id FK
        text status
        timestamptz scheduled_for "unique(workflow_id, scheduled_for)"
    }
    quick_threads {
        uuid id PK
        uuid user_id FK
        text context_type
        uuid context_id
    }
    quick_messages {
        uuid id PK
        uuid thread_id FK
        int position
        text role
        text content
    }
    usage_records {
        uuid id PK
        uuid run_id FK
        uuid user_id FK
        uuid workspace_id FK
        text meter "llm_input_tokens|llm_output_tokens|cached_tokens|sandbox_vcpu_seconds|storage_bytes"
        text provider_model
        numeric quantity
        numeric est_cost_usd
        timestamptz occurred_at
    }
    audit_log {
        bigint id PK
        uuid actor_user_id FK
        uuid workspace_id
        text action
        text target_type
        uuid target_id
        inet ip
        jsonb details
        timestamptz occurred_at
    }
