# Copy to backend/.env. Never commit real credentials.
DSAI_DATABASE_URL=sqlite:///backend/dsai.db
DSAI_STORAGE_ROOT=backend/storage
DSAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DSAI_GEMINI_API_KEY=
DSAI_TAVILY_API_KEY=
DSAI_E2B_API_KEY=
# Conventional TAVILY_API_KEY and E2B_API_KEY names are also accepted.
# model:effort|effort entries form the backend allowlist.
DSAI_GEMINI_MODELS=gemini-3.8-flash:low|medium|high
DSAI_DEFAULT_MODEL_ID=gemini-3.8-flash
DSAI_CONNECTOR_ENCRYPTION_KEY=PASTE_YOUR_GENERATED_KEY_HERE

# Google Drive connector (OAuth client of type "Web application").
# Authorized redirect URI in Google Cloud: http://localhost:8000/api/connectors/google-drive/callback
DSAI_GOOGLE_CLIENT_ID=
DSAI_GOOGLE_CLIENT_SECRET=
# Encrypts stored tokens and signs OAuth state: python -c "import secrets;print(secrets.token_urlsafe(32))"
DSAI_CONNECTOR_SECRET=
# Only change these if the app is served somewhere other than localhost.
# DSAI_GOOGLE_REDIRECT_URI=http://localhost:8000/api/connectors/google-drive/callback
# DSAI_FRONTEND_URL=http://localhost:3000
