# =====================================================================
# DSAI Agentic Backend - Environment Configuration
# Copy this file to `backend/.env`
# =====================================================================

# 1. Google Gemini API (Required for autonomous ReAct reasoning)
# Get a free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model (e.g. gemini-3.1-flash-lite, gemini-3.8-flash)
# gemini-3.1-flash-lite is optimized for sub-5s ultra-low latency response
GEMINI_MODEL=gemini-3.1-flash-lite

# 2. Web Search Tool (Optional)
# Get a free API key from https://tavily.com/
# If unset or missing, web_search automatically falls back to Wikipedia OpenSearch
TAVILY_API_KEY=tvly-your_tavily_key_here

# 3. Langfuse Observability & Tracing (Optional)
# Get keys from https://cloud.langfuse.com (Settings -> API Keys)
# If unset, observability runs completely locally in backend/logs/ with zero overhead
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com
